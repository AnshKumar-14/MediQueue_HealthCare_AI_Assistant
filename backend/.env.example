PORT=5000
FRONTEND_URL=http://localhost:3000
JWT_SECRET=replace_with_a_long_random_secret

# Encrypts sensitive medical fields and chat content (AES-256-GCM).
# Falls back to JWT_SECRET when empty. Set this once in production and keep it
# stable. Records encrypted before this key existed still decrypt with
# JWT_SECRET, so enabling it later does not lose existing data.
DATA_ENCRYPTION_KEY=

# Persistent database (MongoDB Atlas or local MongoDB / Compass).
# Leave empty to use the built-in in-memory MongoDB for local development.
# Set USE_MEMORY_DB=true to force the in-memory database even when MONGO_URI is set.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/mediqueue
USE_MEMORY_DB=false

# --- AI chat assistant ---
# Retention and abuse protection
CHAT_RETENTION_DAYS=30
CHAT_MESSAGES_PER_HOUR=60
CHAT_REQUESTS_PER_MINUTE=40

# Optional background reminders (medication / follow-up)
CHAT_REMINDERS_ENABLED=true
CHAT_REMINDER_INTERVAL_MS=60000

# Shared secret for the WhatsApp / SMS webhook (leave empty to disable)
CHAT_WEBHOOK_SECRET=

# Optional outbound delivery for SMS / WhatsApp / email reminders.
# Use either Twilio or a generic JSON gateway (CHANNEL_OUTBOUND_URL).
CHANNEL_OUTBOUND_URL=
CHANNEL_OUTBOUND_SECRET=
CHANNEL_TIMEOUT_MS=10000
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# Optional LLM layer. Without a key the deterministic engine handles every reply.
# Anthropic (preferred when set)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Any OpenAI-compatible endpoint (OpenAI, Azure, Groq, Ollama, etc.)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=20000
